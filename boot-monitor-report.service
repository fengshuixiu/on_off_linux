[Unit]
Description=Boot Hardware Check and Report Service (late stage)
Documentation=man:systemd.service(5)
# 由 boot-monitor-report.timer 触发，启动耗时口径需要 systemd 启动事务结束之后才取得到。
# 本单元不能被任何 target 拉起（因此没有 [Install] 段）：一旦它成为启动事务的成员，
# 事务要等它退出才算结束，它自己又在等事务结束，systemd-analyze 会永远回"尚未完成"。
# 需要临时手动跑一次：sudo /opt/boot_monitor/boot_counter.sh report

[Service]
Type=oneshot
ExecStart=/opt/boot_monitor/boot_counter.sh report
# 输出到控制台和日志，让用户看到进度
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=no

# 关机时快速退出，不要等待
TimeoutStopSec=5

# 运行环境设置
User=root
Group=root
WorkingDirectory=/opt/boot_monitor

# 等待启动事务结束 90 秒 + 硬件检测 300 秒 + 重启倒计时 15 秒 + 落盘余量
Environment=BOOT_WAIT_MAX_SEC=90
# 与启动时间基准的允许偏差（秒），超出即告警
Environment=BOOT_TIME_TOLERANCE_SEC=5
# 循环重启测试：系统启动完成后等待的秒数（倒计时零点为启动事务结束）
Environment=REBOOT_DELAY_SEC=15
TimeoutStartSec=450

# 报告阶段在启动完成之后，不再抢占启动关键路径的 IO
IOSchedulingClass=best-effort
