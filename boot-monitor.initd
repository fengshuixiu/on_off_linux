#!/bin/sh
### BEGIN INIT INFO
# Provides:          boot-monitor
# Required-Start:    $local_fs $network
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Boot counter and hardware check
### END INIT INFO

DAEMON=/opt/boot_monitor/boot_counter.sh
NAME=boot-monitor

case "$1" in
    start)
        [ -x "$DAEMON" ] || { echo "$NAME: $DAEMON not executable"; exit 5; }
        echo "Starting $NAME"
        "$DAEMON" || echo "$NAME: boot task returned non-zero"
        ;;
    stop)
        # 一次性任务，运行结束即退出，没有常驻进程
        ;;
    restart|force-reload)
        [ -x "$DAEMON" ] || exit 5
        "$DAEMON" || echo "$NAME: boot task returned non-zero"
        ;;
    status)
        echo "$NAME is a oneshot boot task"
        [ -f /opt/boot_monitor/boot_count.txt ] &&
            echo "boot count: $(cat /opt/boot_monitor/boot_count.txt)"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 2
        ;;
esac
exit 0
